# ===== Rahbar nazorati — sozlamalar =====
# Bu faylni nusxalab, nomini ".env" qiling va qiymatlarni to'ldiring.

# Neon.tech bergan PostgreSQL manzili (qo'shtirnoq ichida)
DATABASE_URL="postgresql://USER:PAROL@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# BotFather bergan token
BOT_TOKEN="1234567890:AAH..."

# Anthropic (Claude) API kaliti. Hozircha bo'sh qoldirsangiz ham bo'ladi — AI funksiyalari o'chiq turadi.
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-opus-5-5"

# Direktorning Telegram ID raqami (@userinfobot orqali)
DIRECTOR_TELEGRAM_ID="123456789"

# Web Dashboard uchun login va parol
ADMIN_LOGIN="admin"
ADMIN_PASSWORD="kuchli-parol"

# Istalgan uzun tasodifiy matn (kamida 16 belgi)
JWT_SECRET="bu-yerga-uzun-tasodifiy-matn-yozing"

# ngrok bergan https manzil (oxirida / belgisisiz). Hozircha bo'sh qolishi mumkin.
WEBAPP_URL=""

# Server porti
PORT=3000
