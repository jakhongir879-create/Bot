# ===== MAJBURIY =====
# Neon.tech dan olingan PostgreSQL manzili (Connection string)
DATABASE_URL="postgresql://user:parol@ep-xxxx.eu-central-1.aws.neon.tech/neondb?sslmode=require"

# BotFather bergan token
BOT_TOKEN="1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Sizning Telegram ID raqamingiz (@userinfobot dan bilib olasiz). Bir nechta bo'lsa vergul bilan: 111,222
OWNER_IDS="123456789"

# Dashboard saytiga kirish paroli
ADMIN_PASSWORD="admin123"

# Ixtiyoriy uzun tasodifiy matn (xavfsizlik kaliti)
JWT_SECRET="bu-yerga-uzun-tasodifiy-matn-yozing"

# ===== IXTIYORIY =====
PORT=4000
# ngrok bergan https manzil (Telegram ichida dashboard ochish uchun)
WEBAPP_URL=""
# Kunlik hisobot yuboriladigan vaqt (Toshkent vaqti)
DAILY_REPORT_TIME="21:00"
# Biznes nomi (hisobotlarda ko'rinadi)
BUSINESS_NAME="Mening biznesim"
# Har bir yangi sotuv haqida adminlarga xabar yuborish (true/false)
NOTIFY_NEW_SALES="false"
